<script type="text/javascript">
    $(document).ready(function(e){
        genRowspan("first");
    });

    function genRowspan(className){
        $("." + className).each(function(i) {
            var rows = $("." + className + ":contains('" + $(this).text() + "')");
            var firstEl = document.getElementsByClassName("first")[i];
            if (!firstEl || !firstEl.childNodes || !firstEl.childNodes[0]) return;
            var str = firstEl.childNodes[0].nodeValue;
            if (str && (str.trim() =="심사기관" || str.trim() =="지정")){
                if (rows.length > 1) {
                    rows.eq(0).attr("rowspan", rows.length);
                    rows.not(":eq(0)").remove();
                }
            }
        });
    }
</script>

